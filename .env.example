# ==============================================================================
# ClassITSCe - Plantilla de Variables de Entorno (.env.example)
# Tecnológico Nacional de México Campus Centla
# ==============================================================================
# Copia este archivo a .env.local y configura tus valores reales:
# cp .env.example .env.local
# NUNCA subas credenciales reales ni archivos .env* a repositorios Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de datos PostgreSQL, Auth & Storage)
# ------------------------------------------------------------------------------
# URL del proyecto en Supabase (ej. https://abcdefghijklmnopqrst.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"

# Clave pública anónima (Anon Key) para operaciones en cliente y servidor
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_para_ejemplo_de_configuracion"

# Clave secreta con privilegios de servicio (Service Role Key).
# USO EXCLUSIVO EN SERVIDOR (Auth Admin API). NUNCA exponer en cliente ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key_para_ejemplo_de_configuracion"

# ------------------------------------------------------------------------------
# 2. DOMINIO / URL BASE DE LA APLICACIÓN
# ------------------------------------------------------------------------------
# En desarrollo: http://localhost:3000
# En producción: https://classitsce.centla.tecnm.mx
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. SERVIDOR DE CORREO SMTP (Invitaciones Institucionales)
# ------------------------------------------------------------------------------
# Servidor SMTP (ej. smtp.gmail.com para Google Workspace Institucional)
EMAIL_SERVER_HOST="smtp.gmail.com"

# Puerto SMTP (465 para SSL/TLS directo, 587 para STARTTLS)
EMAIL_SERVER_PORT="465"

# Usuario SMTP / Correo emisor institucional
EMAIL_SERVER_USER="notificaciones@centla.tecnm.mx"

# Contraseña de aplicación SMTP (Google App Password de 16 caracteres)
EMAIL_SERVER_PASSWORD="xxxx xxxx xxxx xxxx"

# Cabecera 'From' visible para el destinatario
EMAIL_FROM="\"ClassITSCe - TecNM Centla\" <notificaciones@centla.tecnm.mx>"
